# --- Required ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/uplift"
AUTH_SECRET=""                 # generate with: npx auth secret
NEXT_PUBLIC_SITE_URL="https://your-domain.org"   # no trailing slash; used for canonical URLs, sitemap, SEO
AUTH_TRUST_HOST="true"          # needed when not hosted on Vercel
# --- First admin (used only by `npm run seed`; skipped if the user already exists) ---
ADMIN_EMAIL=""
ADMIN_PASSWORD=""              # 12+ chars with upper, lower and a number
# --- Image storage (S3-compatible: Cloudflare R2, AWS S3, etc.). Uploads are disabled until set ---
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL=""          # public base URL of the bucket/CDN, e.g. https://cdn.example.org
STORAGE_ENDPOINT=""            # R2: https://<accountid>.r2.cloudflarestorage.com ; leave empty for AWS S3
STORAGE_REGION="auto"          # AWS: e.g. eu-west-1
# --- Optional production rate limiting (Upstash Redis REST). Falls back to in-memory if empty ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
