generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { ADMIN EDITOR }
enum SubmissionStatus { NEW CONTACTED APPROVED DECLINED ARCHIVED }
enum MessageStatus { UNREAD READ ARCHIVED }

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(EDITOR)
  active       Boolean  @default(true)
  articles     Article[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProgramCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  programs  Program[]
  createdAt DateTime  @default(now())
}

model Program {
  id          String           @id @default(cuid())
  title       String
  slug        String           @unique
  summary     String           @db.VarChar(300)
  body        String?          @db.Text
  published   Boolean          @default(false)
  sortOrder   Int              @default(0)
  categoryId  String?
  category    ProgramCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  imageId     String?
  image       Media?           @relation(fields: [imageId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  @@index([published, sortOrder])
}

model ArticleCategory {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  articles Article[]
}

model Article {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  excerpt     String          @db.VarChar(300)
  body        String          @db.Text
  published   Boolean         @default(false)
  publishedAt DateTime?
  seoTitle    String?  @db.VarChar(70)
  seoDescription String? @db.VarChar(160)
  categoryId  String?
  category    ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId    String?
  author      AdminUser?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  imageId     String?
  image       Media?          @relation(fields: [imageId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  @@index([published, publishedAt])
}

model ImpactStat {
  id        String   @id @default(cuid())
  label     String
  value     Int      @default(0)
  suffix    String   @default("+")
  verified  Boolean  @default(false)
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
  @@index([verified, published, sortOrder])
}

model ImpactStory {
  id         String   @id @default(cuid())
  initiative String
  community  String
  action     String   @db.Text
  result     String   @db.Text
  published  Boolean  @default(false)
  occurredAt DateTime?
  imageId    String?
  image      Media?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([published, createdAt])
}

model Volunteer {
  id           String           @id @default(cuid())
  fullName     String
  email        String
  phone        String?
  location     String?
  interest     String
  availability String?
  message      String?          @db.Text
  status       SubmissionStatus @default(NEW)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  @@index([status, createdAt])
}

model PartnershipRequest {
  id              String           @id @default(cuid())
  organization    String
  contactPerson   String
  email           String
  phone           String?
  partnershipType String
  message         String?          @db.Text
  status          SubmissionStatus @default(NEW)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  @@index([status, createdAt])
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String        @db.Text
  status    MessageStatus @default(UNREAD)
  createdAt DateTime      @default(now())
  @@index([status, createdAt])
}

// Key/value site settings: foundation_name, email, phone, address, instagram, tiktok, etc.
model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  url       String
  storageKey String  @unique
  mimeType  String
  sizeBytes Int
  alt       String
  programs  Program[]
  articles  Article[]
  stories   ImpactStory[]
  createdAt DateTime @default(now())
  @@index([createdAt])
}
