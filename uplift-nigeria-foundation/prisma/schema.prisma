generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum SubmissionStatus {
  NEW
  CONTACTED
  APPROVED
  DECLINED
}

enum MessageStatus {
  UNREAD
  READ
  ARCHIVED
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(EDITOR)
  active       Boolean   @default(true)
  articles     Article[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ProgramCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  programs  Program[]
  createdAt DateTime  @default(now())
}

model Program {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  summary     String          @db.VarChar(300)
  body        String?         @db.Text
  published   Boolean         @default(false)
  sortOrder   Int             @default(0)
  categoryId  String
  category    ProgramCategory @relation(fields: [categoryId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ArticleCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  articles  Article[]
  createdAt DateTime  @default(now())
}

model Article {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  content     String          @db.Text
  published   Boolean         @default(false)
  categoryId  String
  category    ArticleCategory @relation(fields: [categoryId], references: [id])
  authorId    String
  author      AdminUser       @relation(fields: [authorId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  url       String
  filename  String
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())
}

model ImpactStat {
  id        String   @id @default(cuid())
  label     String
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ImpactStory {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String   @db.VarChar(300)
  body        String   @db.Text
  imageUrl    String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Volunteer {
  id          String           @id @default(cuid())
  name        String
  email       String
  phone       String?
  interests   String[]
  status      SubmissionStatus @default(NEW)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String        @db.Text
  status    MessageStatus @default(UNREAD)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model PartnershipRequest {
  id           String           @id @default(cuid())
  organization String
  contactName  String
  email        String
  phone        String?
  details      String           @db.Text
  status       SubmissionStatus @default(NEW)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}
